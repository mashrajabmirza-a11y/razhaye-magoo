---
layout: null
permalink: /search.json
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: "%Y-%m-%d" | jsonify }},"tags":{{ post.tags | join: " · " | jsonify }},"description":{{ post.description | default: "" | jsonify }},"body":{{ post.content | strip_html | truncate: 1200 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
